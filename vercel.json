{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/agencia/index.html" }
  ],
  "redirects": [
    { "source": "/agencia", "destination": "/", "permanent": true },
    { "source": "/agencia/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/agencia/(fonts|images|videos|sistema|swiper|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
